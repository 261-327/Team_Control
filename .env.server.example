# Copy to .env.server; never commit the filled file.
FRONTEND_URL=https://sipi.example.org
DJANGO_ALLOWED_HOSTS=sipi.example.org
CSRF_TRUSTED_ORIGINS=https://sipi.example.org
# Generate a new value with: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
COOKIE_SECURE=true

# Keep the SAME database and credentials as the team's current Django server.
# DB_HOST=db is for compose.server-db.yaml. For external PostgreSQL use its real host.
DB_HOST=db
DB_PORT=5432
DB_NAME=team_control_db
DB_USER=postgres_user
DB_PASSWORD=
DB_SSLMODE=prefer
# Exact name of the existing Docker volume when using bundled PostgreSQL.
POSTGRES_VOLUME=backend_postgres_data

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

# Local application gateway behind the server's HTTPS proxy.
SIPI_BIND_ADDRESS=127.0.0.1
SIPI_PORT=8080
WEB_CONCURRENCY=2

# Local Qwen inside Docker; no paid provider credentials required.
ASSISTANT_MODEL=qwen3:4b
# Add compose.images.yaml for the optional local image worker.

# PostgreSQL backup to a separate private Cloudflare R2 bucket.
# Create a bucket-scoped Object Read & Write key; do not reuse app upload credentials.
BACKUP_DB_MODE=docker
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=team-control/postgres
BACKUP_RETENTION_DAYS=7
