# start.sh reads backend/.env. Never commit the real file.
# Without Docker start.sh defaults to SQLite + console email.
DB_ENGINE=sqlite
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-account@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=your-account@example.com
# Docker Compose reads the .env in the directory where you run it.
# Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend to deliver real mail.

# Free local assistant. setup-ai.sh installs Qwen; start.sh starts the workers.
ASSISTANT_MODEL=qwen3:4b
ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
# ASSISTANT_IMAGES_ENABLED=true
# ASSISTANT_IMAGE_MODEL=/absolute/path/to/.runtime/image-model
# ASSISTANT_TIMEOUT=240

# Private persistent object storage (optional).
# Local development and Docker keep using the filesystem by default.
# Vercel defaults to database storage. To test the free pilot locally, set database.
PROJECT_MEDIA_STORAGE=filesystem
# To enable Cloudflare R2 (or another S3-compatible private bucket), set:
# PROJECT_MEDIA_STORAGE=s3
# OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_BUCKET=your-private-bucket-name
# OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
# OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-key
# OBJECT_STORAGE_REGION=auto
