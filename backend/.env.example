# start.sh reads backend/.env. Never commit the real file.
# Without Docker start.sh defaults to SQLite + console email.
DB_ENGINE=sqlite
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-account@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=your-account@example.com
# Docker Compose reads the .env in the directory where you run it.
# Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend to deliver real mail.
