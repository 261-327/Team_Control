<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SipiSanzhapov" parent="Theme.Material3.Light.NoActionBar">
        <!-- Фирменный цвет (кнопки, активные элементы, выделение) -->
        <item name="colorPrimary">@color/sipe_yellow_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Фон окна и статус-бар: тот же бежевый, что на регистрации -->
        <item name="android:windowBackground">@color/beige</item>
        <item name="android:statusBarColor">@color/beige</item>
        <!-- Тёмные иконки статус-бара -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>