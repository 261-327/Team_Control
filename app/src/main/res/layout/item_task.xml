<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Дата дедлайна -->
        <TextView
            android:id="@+id/tvDeadlineDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/card_text"
            android:text="Сдать до: 30.10.2026 18:00" />

        <!-- Сколько дней осталось -->
        <TextView
            android:id="@+id/tvTimeRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/card_text"
            android:text="Осталось 2 дня" />

        <!-- Заголовок задачи -->
        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сделать прототип"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/card_text" />

        <!-- Описание задачи -->
        <TextView
            android:id="@+id/tvTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="построить вкусно и точка"
            android:textSize="14sp"
            android:textColor="@color/card_text"
            android:maxLines="3"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tvShowMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Подробнее"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/card_text"
            android:visibility="gone" />


        <!-- Превью картинки (если прикреплена) -->
        <ImageView
            android:id="@+id/ivTaskImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:background="@color/divider"
            android:visibility="visible"
            android:contentDescription="Превью вложения" />

        <!-- Нижняя строка: файлы, кнопка и аватар -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFilesInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📎 IMG-001.png"
                android:textSize="12sp"
                android:textColor="@color/card_text" />

            <Button
                android:id="@+id/btnSubmitReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="На проверку"
                android:textSize="12sp"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/sipe_yellow_dark"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivAssignee"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/default_avatar" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>