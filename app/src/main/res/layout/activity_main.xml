<?xml version="1.0" encoding="utf-8"?>
<!-- 1. САМЫЙ КОРНЕВОЙ ЭЛЕМЕНТ: Выезжающее меню (DrawerLayout) -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 2. ТВОЙ ОСНОВНОЙ ЭКРАН (CoordinatorLayout) -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/beige">

        <!-- Верхняя панель (AppBar + Toolbar) -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/beige"
            android:fitsSystemWindows="true"
            app:elevation="4dp">

            <!-- Изменили ID на toolbar, чтобы код из MainActivity к нему подцепился -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_menu"
                app:title=""
                app:menu="@menu/top_bar_menu">

                <!-- Логотип Сипи (если хочешь оставить, он останется тут) -->
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logotip_sipi"
                    android:contentDescription="Логотип Сипи" />

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Центр: ViewPager2 для списков задач -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:layout_marginBottom="56dp" />

        <!-- Нижняя панель навигации -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/white"
            app:itemIconTint="@color/sipe_yellow_dark"
            app:itemTextColor="@color/sipe_dark_text"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"
            app:elevation="8dp" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 3. БОКОВАЯ ШТОРКА (NavigationView), которая будет выезжать при нажатии на 3 полоски -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>