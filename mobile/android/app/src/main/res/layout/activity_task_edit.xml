<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarEdit"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/beige"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/text_primary"
        tools:title="Новая задача" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_form_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                style="@style/SipiFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_form_title_label" />

            <EditText
                android:id="@+id/etTitle"
                style="@style/SipiEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/task_form_title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="200" />

            <TextView
                style="@style/SipiFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_form_description_label" />

            <EditText
                android:id="@+id/etDescription"
                style="@style/SipiEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/task_form_description_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/task_form_description_help"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <TextView
                style="@style/SipiFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_form_project_label" />

            <Spinner
                android:id="@+id/spinnerProject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_edittext" />

            <TextView
                style="@style/SipiFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_form_assignee_label" />

            <Spinner
                android:id="@+id/spinnerAssignee"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_edittext" />

            <TextView
                style="@style/SipiFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_form_deadline_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDeadlineValue"
                    style="@style/SipiEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/ic_schedule"
                    android:drawableTint="@color/text_secondary"
                    tools:text="02.11.2026 14:35" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnClearDeadline"
                    style="@style/SipiSecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/task_form_clear_deadline" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/task_form_deadline_help"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <TextView
                style="@style/SipiFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_form_direction_label" />

            <Spinner
                android:id="@+id/spinnerDirection"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_edittext" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveTask"
                style="@style/SipiPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/action_save" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
