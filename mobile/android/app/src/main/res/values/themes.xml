<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SIPI_AI" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/mustard</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryInverse">@color/mustard</item>
        <item name="colorSecondaryContainer">@color/mustard_soft</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="android:windowBackground">@color/beige</item>
        <item name="android:statusBarColor">@color/beige</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="CalendarWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="SipiCard">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/field_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="SipiSectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SipiFieldLabel">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SipiEditText">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SipiPrimaryButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SipiSecondaryButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
