# Copy this file to .env in the repository root (next to compose.yaml).
# Never put real passwords in GitHub. Replace the placeholders locally.
#
# Yandex Mail SMTP settings:
# EMAIL_HOST_USER: your full @yandex.ru address
# EMAIL_HOST_PASSWORD: a Yandex app password for Mail, not your normal account password.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_ADDRESS@yandex.ru
EMAIL_HOST_PASSWORD=PASTE_YANDEX_APP_PASSWORD_HERE
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=YOUR_ADDRESS@yandex.ru

# Optional local development settings (Compose has safe defaults):
# DB_PASSWORD=change-me
# DJANGO_SECRET_KEY=change-me-for-local-development
