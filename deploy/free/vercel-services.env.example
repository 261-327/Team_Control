# Vercel project environment: Production ONLY. Project Root Directory: .
# Keep Preview without production credentials. The build intentionally rejects Preview.
# Examples only; replace values in the dashboard, never commit real secrets.
SIPI_VERCEL_SERVICES=true
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-generated-secret
DATABASE_URL=postgresql://user:password@your-neon-pooler-host/database?sslmode=require
DB_SSLMODE=require
# Optional: omit for the first deployment. Vercel supplies the stable production domain.
# Enable access to System Environment Variables in the project settings.
# FRONTEND_URL=https://your-custom-domain.example
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true
# Mail: choose ONE provider block. Values below are placeholders, not an account.
# Option A: an existing mailbox with secure SMTP (provider/app password required).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=465
EMAIL_HOST_USER=sender@your-domain.example
EMAIL_HOST_PASSWORD=replace-with-provider-app-password-in-vercel
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=sender@your-domain.example
# For STARTTLS instead: EMAIL_PORT=587, EMAIL_USE_SSL=false, EMAIL_USE_TLS=true.
# Option B: Brevo HTTPS, only after truthful onboarding and sender verification.
# EMAIL_BACKEND=tasks.email_backends.BrevoEmailBackend
# BREVO_API_KEY=replace-in-vercel-production-dashboard
# DEFAULT_FROM_EMAIL=verified-sender@your-domain.example
# SMTP does not require BREVO_API_KEY; Brevo does not require SMTP credentials.
ASSISTANT_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=replace-with-your-32-character-account-id
CLOUDFLARE_API_TOKEN=replace-in-vercel-production-dashboard
ASSISTANT_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ASSISTANT_CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
ASSISTANT_IMAGES_ENABLED=true
ASSISTANT_TIMEOUT=60
# DJANGO_API_URL is injected at runtime by the frontend -> backend service binding.
# Do not add DJANGO_API_URL manually, or use NEXT_PUBLIC_* for any of these settings.
# Canonical links use FRONTEND_URL, or VERCEL_PROJECT_PRODUCTION_URL when unset.
# VERCEL_URL is only an additional allowed origin, never the canonical reset-link URL.
# Exact ALLOWED_HOSTS and CSRF origins derive from those validated project domains.
